# Copy to .env, replace every secret, then run `make infra-validate`.
POSTGRES_DB=runsphere
POSTGRES_USER=runsphere
POSTGRES_PASSWORD=replace-with-a-long-unique-password
POSTGRES_HOST_PORT=5432

# Conservative PostgreSQL limits for a small Mumbai-region deployment.
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_EFFECTIVE_CACHE_SIZE=384MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_MAX_CONNECTIONS=40
POSTGRES_LOG_MIN_DURATION_STATEMENT=500

# Operations profile only. Do not expose pgAdmin publicly.
PGADMIN_DEFAULT_EMAIL=ops@runsphere.local
PGADMIN_DEFAULT_PASSWORD=replace-with-a-separate-long-password
PGADMIN_HOST_PORT=5050

# Maps profile only. Martin serves application-owned PostGIS vector data;
# it does not download, proxy, or publish third-party basemap tiles.
MARTIN_DATABASE_URL=postgresql://runsphere:replace-with-a-long-unique-password@postgres:5432/runsphere
MARTIN_HOST_PORT=3000

# Routing profile only. Provide licensed, privately hosted regional extracts.
# Leave empty to keep Valhalla as a non-production placeholder.
VALHALLA_TILE_URLS=
VALHALLA_HOST_PORT=8002

# Comma-separated account UUIDs allowed to use the staff activity review queue.
# Keep empty until a staff account has been provisioned through the normal auth flow.
STAFF_REVIEW_ACCOUNT_IDS=

# Firebase Cloud Messaging service account for worker push delivery. All three
# are required together: a half-configured provider is treated as unconfigured,
# and the worker then logs `push.provider_unconfigured` and delivers nothing
# while the durable in-app inbox keeps working. Pushes carry only a
# notification id and its safe deep link, never titles, bodies, or scores.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# API and worker
# ---------------------------------------------------------------------------
# These are read by `services/api` and `services/worker` through `process.env`.
# Neither runs inside `infra/compose.yaml`, so they are not passed through by
# compose — export them however the deployment starts those two processes.

# Signs and verifies access tokens. **There is a development default**
# (`development-secret-not-for-production`) so a local checkout starts without
# configuration; anything reachable from outside a laptop must set this to a
# long random value, because the default is in this repository.
AUTH_TOKEN_SECRET=

# Where the API and worker find PostgreSQL. Falls back to the compose values
# above when unset (`defaultDatabaseUrl`).
DATABASE_URL=

# Public base URL for links the worker puts in email — password resets, the
# unsubscribe endpoint. Without it, transactional email is not sent at all: a
# reset link pointing at localhost is worse than no reset link.
APP_BASE_URL=

PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:4173
# Bearer token the metrics scrape must present. Unset leaves metrics closed.
METRICS_COLLECTOR_TOKEN=

# Runs one worker sweep and exits, instead of looping. For cron-style
# deployments and for debugging.
WORKER_ONCE=

# ---------------------------------------------------------------------------
# Email (transactional and campaign)
# ---------------------------------------------------------------------------
# All of `EMAIL_API_URL`, `EMAIL_API_KEY`, `EMAIL_FROM` and `APP_BASE_URL` are
# required together. Half-configured is treated as unconfigured: the worker
# logs `email.provider_unconfigured` and drops the events rather than failing
# them, which would burn the outbox attempt budget and mark deliverable mail
# permanently dead. See `docs/delivery-setup.md`.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=
# HMAC secret the provider signs delivery webhooks with. Without it the webhook
# route refuses every request rather than trusting unsigned bounce reports.
EMAIL_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# ML (anti-cheat scoring and model training) — `docs/ml.md`
# ---------------------------------------------------------------------------
# Both are optional and unset is the normal state. With no scorer URL the claim
# route makes no call and flags nothing, and a run behaves exactly as it did
# before the model existed. Nothing is scored until the feature store holds
# 2,000 labelled runs, whatever these are set to.

# `services/ml` anti-cheat inference. 800 ms default: a claim is a foreground
# request and the model is worth under a second of somebody's wait.
ML_SCORER_URL=
ML_SCORER_TOKEN=
ML_SCORER_TIMEOUT_MS=800

# `services/ml` training endpoint, called by the worker's monthly and weekly
# proposal jobs. Five minutes by default — fitting is not a request.
# A proposal is never promoted automatically; a staff reviewer promotes it by
# signing the row in `ml_models`.
ML_TRAINER_URL=
ML_TRAINER_TOKEN=
ML_TRAINER_TIMEOUT_MS=300000

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# Opens the PostGIS integration suites. CI sets this; a closed gate in CI is a
# hard failure rather than a silent skip (`requirePostgisInCi`).
RUN_POSTGIS_INTEGRATION=

# ---------------------------------------------------------------------------
# Mobile build
# ---------------------------------------------------------------------------
# Path to the Firebase `google-services.json`. Defaults to
# `./google-services.json` in `apps/mobile`. Push is not delivered without it.
# Mobile runtime configuration lives in `apps/mobile/.env.example`.
GOOGLE_SERVICES_JSON=
