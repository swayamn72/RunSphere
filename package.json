{
  "name": "runsphere",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=10.12.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:admin": "pnpm --filter @runsphere/admin dev",
    "dev:api": "pnpm --filter @runsphere/api dev",
    "dev:mobile": "pnpm --filter @runsphere/mobile start",
    "verify:maplibre": "node scripts/verify-maplibre-compatibility.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "lint": "turbo run lint --continue",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test --continue",
    "migrate": "node scripts/migrate.mjs",
    "test:integration": "pnpm --filter @runsphere/api exec vitest run src/integration.test.ts src/territory-claim.integration.test.ts src/friend-standings.integration.test.ts && pnpm --filter @runsphere/worker exec vitest run src/territory-claim-season.integration.test.ts src/email-delivery.integration.test.ts",
    "typecheck": "turbo run typecheck --continue"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "24.13.3",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "pg": "8.16.3",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
