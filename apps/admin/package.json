{
  "name": "@runsphere/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint src",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@runsphere/domain": "workspace:*",
    "@runsphere/ui": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@runsphere/config": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "@vitejs/plugin-react": "6.1.0",
    "vite": "8.2.2"
  }
}
