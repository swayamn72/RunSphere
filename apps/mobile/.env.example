# Copy to .env for local development or provide this at build time.
# Do not commit a preview or deployment URL; public preview tunnels are ephemeral.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# Map provider configuration is opt-in and must be approved before use.
# Use an HTTPS style URL and list its exact HTTPS origin. Keep provider credentials
# out of git; use a provider-managed non-user-specific credential at build time only.
# All three values are required for a provider-backed map. Leaving them unset shows
# the app-owned fallback surface; the app never substitutes a public map endpoint.
EXPO_PUBLIC_MAP_STYLE_URL=http://localhost:3001/satellite.json
EXPO_PUBLIC_MAP_STYLE_ORIGINS=http://localhost:3001
EXPO_PUBLIC_MAP_ATTRIBUTION="Tiles © Esri — Source: Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP, and the GIS User Community"

# Environment name the API client uses to decide how strict to be about the
# base URL. Falls back to NODE_ENV, then to `development`.
EXPO_PUBLIC_APP_ENV=development

# Replays a recorded GPS trace instead of reading the device's location, so a
# run can be exercised on an emulator or at a desk. **Development builds only**
# — `location-adapter.ts` gates it on `__DEV__` as well, so setting it in a
# release build does nothing.
EXPO_PUBLIC_SYNTHETIC_LOCATION=false
# NDJSON of `{latitude, longitude, recordedAt}` objects, one per line.
EXPO_PUBLIC_SYNTHETIC_LOCATION_NDJSON=
