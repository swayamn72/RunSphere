# Copy to .env for local development or provide this at build time.
# Do not commit a preview or deployment URL; public preview tunnels are ephemeral.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# Map provider configuration is opt-in and must be approved before use.
# Use an HTTPS style URL and list its exact HTTPS origin. Keep provider credentials
# out of git; use a provider-managed non-user-specific credential at build time only.
# All three values are required for a provider-backed map. Leaving them unset shows
# the app-owned fallback surface; the app never substitutes a public map endpoint.
EXPO_PUBLIC_MAP_STYLE_URL=
EXPO_PUBLIC_MAP_STYLE_ORIGINS=
EXPO_PUBLIC_MAP_ATTRIBUTION=
