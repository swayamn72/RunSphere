{
  "name": "@runsphere/mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "build": "expo export --platform android",
    "dev": "expo start --lan",
    "lint": "eslint src App.tsx",
    "start": "expo start",
    "test": "vitest run && node src/verify-android-permissions.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "android:assemble:debug": "cd android && ./gradlew clean assembleDebug",
    "verify:android-permissions": "node src/verify-android-permissions.mjs",
    "verify:maplibre-compatibility": "node verify-maplibre-compatibility.mjs"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "11.3.7",
    "@runsphere/contracts": "workspace:*",
    "@runsphere/domain": "workspace:*",
    "@runsphere/ui": "workspace:*",
    "expo": "57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-location": "~57.0.14",
    "expo-secure-store": "~57.0.2",
    "expo-sensors": "~57.0.2",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.14",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "19.2.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "main": "expo/AppEntry"
}
