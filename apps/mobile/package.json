{
  "name": "@runsphere/mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform android",
    "dev": "expo start --lan",
    "lint": "eslint src App.tsx",
    "start": "expo start",
    "test": "vitest run && node src/verify-android-permissions.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "android:assemble:debug": "cd android && ./gradlew clean assembleDebug",
    "ios:build:simulator": "cd ios && xcodebuild -workspace TURFR.xcworkspace -scheme TURFR -configuration Debug -sdk iphonesimulator -destination \"generic/platform=iOS Simulator\" CODE_SIGNING_ALLOWED=NO build",
    "verify:android-permissions": "node src/verify-android-permissions.mjs",
    "verify:maplibre-compatibility": "node verify-maplibre-compatibility.mjs"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "11.3.7",
    "@runsphere/contracts": "workspace:*",
    "@runsphere/domain": "workspace:*",
    "@runsphere/ui": "workspace:*",
    "expo": "57.0.17",
    "expo-background-fetch": "~57.0.21",
    "expo-blur": "~57.0.3",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "^57.0.19",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.14",
    "expo-notifications": "~57.0.6",
    "expo-secure-store": "~57.0.2",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "19.2.14",
    "@types/react-test-renderer": "19.1.0",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "main": "expo/AppEntry"
}
