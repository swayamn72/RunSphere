{
  "name": "@runsphere/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -b --force",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@runsphere/api": "workspace:*",
    "@runsphere/db": "workspace:*",
    "@runsphere/observability": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "vitest": "4.1.11"
  }
}
