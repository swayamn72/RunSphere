{
  "name": "@runsphere/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./activity": {
      "types": "./dist/activity.d.ts",
      "default": "./dist/activity.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b --force",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@runsphere/config": "workspace:*",
    "@runsphere/contracts": "workspace:*",
    "@runsphere/db": "workspace:*",
    "@runsphere/domain": "workspace:*",
    "argon2": "^0.45.1",
    "fastify": "5.12.1"
  },
  "devDependencies": {
    "pino": "10.3.1",
    "tsx": "4.21.0",
    "vitest": "4.1.11"
  }
}
