{
  "name": "@runsphere/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -b --force",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@runsphere/config": "workspace:*",
    "@runsphere/contracts": "workspace:*",
    "@runsphere/domain": "workspace:*",
    "fastify": "5.12.1",
    "@fastify/swagger": "9.8.1"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "vitest": "4.1.11",
    "pino": "10.3.1"
  }
}
