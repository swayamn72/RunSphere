{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", "build/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "POSTGRES_PASSWORD",
        "RUN_POSTGIS_INTEGRATION",
        "AUTH_TOKEN_SECRET",
        "CI"
      ]
    }
  }
}
