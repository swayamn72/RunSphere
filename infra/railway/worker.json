{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.worker",
    "watchPatterns": [
      "Dockerfile.worker",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig*.json",
      "packages/**",
      "services/api/**",
      "services/worker/**",
      "infra/postgres/migrations/**"
    ]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS"
  }
}
